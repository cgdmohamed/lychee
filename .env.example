# Copy to .env (docker compose reads this automatically) and fill in real values.
# Also set these as environment variables in Coolify's app settings if deploying there.

# Only used if you add a docker-compose.override.yaml to publish a host port for running
# `docker compose up` outside Coolify (see README's Docker section) — the default
# docker-compose.yaml doesn't bind a host port at all, so this has no effect on Coolify.
APP_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
SEED_ADMIN_EMAIL=admin@lycheesaudi.com
SEED_ADMIN_PASSWORD=change-me-before-first-deploy
